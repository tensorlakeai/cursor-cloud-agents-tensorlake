# Copy to .env and replace the placeholders. Never commit .env.

# --- Cursor ---

# Cursor Enterprise service-account API key. Pool workers accept only this key
# type. Create one at Dashboard > Settings > API Keys > Service Accounts.
# Leave empty for My Machines (cursor-tl-my-machine), which uses
# CURSOR_USER_API_KEY instead.
CURSOR_API_KEY=

# Cursor pool the orchestrator serves. One orchestrator per pool.
CURSOR_POOL=tensorlake

# How the pool maps to repositories.
#   repo      Default. Each worker gets the request's repository as `origin`
#             before it starts, joins the repo-bound pool row, and the checkout
#             hook fetches the code. Cursor adds one repo-bound row per
#             repository as workers connect. Optionally pin one repository
#             with CURSOR_POOL_REPO_URL.
#   any-repo  One pool row for every repository. Workers start with no
#             `origin` and --clone-git-repos; Cursor clones after the claim.
#             Pick the pool under "Any repo" at cursor.com/agents.
CURSOR_POOL_MODE=repo

# Optional, mode `repo` only: pin the pool to one HTTPS repository, for example
# https://github.com/org/repo. The controller then registers only the
# repo-bound row and claims only that repository's requests. Without it the
# controller also keeps an any-repo row that no repo-bound worker joins; if
# the web picker offers that row, the request fails with "No self-hosted
# worker matches the requested labels".
CURSOR_POOL_REPO_URL=

# Cursor REST API base. The orchestrator uses it for pool and claim calls.
# It is never forwarded into a worker sandbox.
CURSOR_API_URL=https://api.cursor.com

# Personal Cursor API key from Dashboard > API Keys. Works on any plan.
# Only cursor-tl-my-machine uses it.
CURSOR_USER_API_KEY=

# Do not set CURSOR_AGENT_WORKER_ID, CURSOR_POOL claim values, or
# CURSOR_REQUEST_ID here. The Cursor controller supplies them to the spawn hook.

# --- Tensorlake ---

# Tensorlake API key. It selects the Tensorlake project. Get one at
# https://cloud.tensorlake.ai. Values in this file win over your shell, so a
# key exported by an IDE terminal cannot send sandboxes to another project.
TENSORLAKE_API_KEY=replace-with-tensorlake-api-key

# Optional: pin organization, project, and namespace when your account spans
# more than one. Blank uses the SDK defaults.
TENSORLAKE_ORGANIZATION_ID=
TENSORLAKE_PROJECT_ID=
TENSORLAKE_NAMESPACE=

# --- Images ---

# Registered worker image. Leave blank to build with the recipe-hash name, then
# copy the printed name here before you launch the orchestrator. A stale
# cursor-tl-worker-<sha8> pin is ignored by the builder when the recipe changes,
# for example after WORKER_COMPUTER_USE is turned on.
IMAGE_NAME=
# Base for the worker image. Blank picks tensorlake/ubuntu-minimal, or
# tensorlake/ubuntu-vnc when WORKER_COMPUTER_USE=true.
IMAGE_BASE=
# Register built images as public so any Tensorlake namespace can run them.
IMAGE_PUBLIC=false
# Base for the orchestrator image. It never needs a desktop.
ORCHESTRATOR_IMAGE_BASE=tensorlake/ubuntu-minimal

# Cursor CLI lab-channel build baked into the image. `agent worker controller`
# exists only on the lab channel. Change both values together.
CURSOR_CLI_VERSION=2026.09.02-e3e9343
CURSOR_CLI_B2SUM=a29694895b3b5d90e7d751eddfd2682e4872c9db6c2a3dee9eb3940a74d58c1cd498be3cc5ddf22bc7a22f2e8011e7430e5392149d1704ce952b368fa105d484

# --- Worker sandboxes ---

SANDBOX_CPUS=2
SANDBOX_MEMORY_MB=4096
SANDBOX_DISK_MB=20480

# Idle threshold (seconds) before Tensorlake suspends a worker sandbox that
# receives no SDK traffic. The janitor polls more often than this, so a live
# session never hits it. It is the safety net if the orchestrator dies:
# a named sandbox suspends, it is never destroyed. 0 requests the plan maximum.
SANDBOX_TIMEOUT_SECS=3600

# Optional egress allowlist, comma separated. Blank allows all outbound traffic.
# The worker needs: api2.cursor.sh, api2direct.cursor.sh,
# cloud-agent-artifacts.s3.us-east-1.amazonaws.com, github.com, plus the
# package hosts your builds use.
SANDBOX_ALLOW_OUT=

# Seconds a worker stays connected after a session ends, waiting for follow-ups.
# When it fires the worker exits 0 and the janitor suspends the sandbox.
WORKER_IDLE_RELEASE_SECS=300

# Optional JSON object of labels the worker advertises to Cursor.
WORKER_LABELS_JSON=

# Let agents drive a desktop and browser. The worker image is built from
# tensorlake/ubuntu-vnc (Xfce, Chrome, Firefox) plus Cursor's Linux desktop
# packages, and each worker starts with --computer-use.
WORKER_COMPUTER_USE=false
# X display the worker attaches to. Blank reuses :1, the desktop the image
# already boots, so there is one desktop per sandbox at a number you can
# record. "managed" lets the worker start its own desktop instead.
WORKER_DISPLAY=
# Optional: let authorized Cursor viewers watch the agent desktop.
# Blank = off; "view" or "view_and_control". This shares a desktop the worker
# creates itself, so it turns WORKER_DISPLAY off unless you set one explicitly.
WORKER_SHARE_DESKTOP=

# --- Orchestrator ---

# Keep N idle workers pre-spawned in the pool (Cursor warm mode). 0 disables.
WARM_IDLE=0

# Most worker sandboxes that may be live (not suspended) at once. When the cap is
# reached, new claims are released back to Cursor and wait in its queue.
# Follow-ups to existing sessions always get through. 0 = no cap.
MAX_WORKERS=0

# Seconds a suspended worker sandbox is kept before the janitor terminates it.
SESSION_RETENTION_SECS=86400

JANITOR_INTERVAL_SECS=30

# Optional belt and braces. The Cursor controller already re-runs the spawn
# hook for a hibernated worker (CURSOR_WAKE=1). Enable this to also poll
# pending requests and resume claimed-but-offline sandboxes from the janitor.
WAKE_OFFLINE_CLAIMS=false

# Seconds the spawn hook waits for the worker process to stay alive.
SANDBOX_LAUNCH_TIMEOUT_SECS=10

# Orchestrator sandbox sizing.
ORCHESTRATOR_CPUS=1
ORCHESTRATOR_MEMORY_MB=2048
ORCHESTRATOR_DISK_MB=20480

# The launcher pins STATE_DIR inside the orchestrator sandbox; a value here
# applies only when you run cursor-tl-orchestrator locally.
STATE_DIR=

LOG_LEVEL=INFO

# --- My Machines quickstart only ---

# Comma-separated HTTPS repo URLs to clone into the machine's workspace.
REPOS=
GIT_USERNAME=
GIT_TOKEN=
